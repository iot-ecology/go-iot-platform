---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import {getPermalink} from '~/utils/permalinks';
import {getBlogPermalink} from "../../utils/permalinks";

const metadata = {
  title: '创始人',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[{
        text: '首页', href: '/',
      }, {
        text: '定价', href: getPermalink('pricing'),
      }, {
        text: '链接', href: getPermalink('contact'),

      },


        {
          text: "我们", links: [{
            text: '团队', href: getPermalink('about'),

          }, {
            text: '作者', href: getPermalink('homes/personal'),
          }]
        }, {
          text: '博客', links: [{
            text: '博客列表', href: getBlogPermalink(),
          }, {
            text: '应用案例', href: getPermalink('case', 'tag'),
          }, {
            text: '操作手册', href: getPermalink('operation', 'tag'),
          },],
        },]}
      actions={[{
        text: '联系我', href: 'mailto:huifer97@163.com',
      },]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Zen HuiFer"
    tagline=""
    actions={[{variant: 'primary', text: '联系我', href: 'mailto:huifer97@163.com'}]}
  >
    <Fragment slot="subtitle">
      我是一个软件开发工程师，更加擅长Java开发和Go语言开发. <br/>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[{
      icon: 'tabler:brand-github', callToAction: {
        target: '_blank', text: 'Github', href: 'http://github.com/huifer',
      },
    }, {
      icon: 'tabler:brand-github', callToAction: {
        target: '_blank', text: 'Gitee', href: 'https://gitee.com/pychfarm_admin/',
      },
    }, {
      icon: 'tabler:mail', callToAction: {
        target: '_blank', text: 'Mail', href: 'mailto:huifer97@163.com',
      },
    },]}
    image={{
      src: '~/assets/images/26766909.jpeg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">关于我</h2>
      <br/>
      <p>
      我擅长软件开发，常规管理后台、物联网开发、地理信息系统开发（GIS）都是我涉猎的范围。非软件开发行业对于测绘行业有深刻认识。
      </p>
      <p>
        参与过Spring Cloud项目建设，曾经任职某酒店集团架构师。
      </p>
      <br/>
      <p>如果您需要软件开发相关的能力支持您可以联系我。</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="工作经验"
    items={[{
      title: '技术负责人 <br /> <span class="font-normal">浙江-杭州</span> <br /> <span' +
        ' class="text-sm' +
        ' font-normal">2023 - 至今</span>',
      description: `在浙江省多个关键地区，如淳安县、富春、兰溪等，我担任了智慧管网和智慧排水项目的技术负责人。在这些项目中，我负责提供创新且稳定的技术解决方案，确保了项目的成功实施和运营效率的显著提升。通过我的领导和技术专长，项目不仅在技术上取得了突破，还在成本控制和资源优化方面取得了显著成效。`,
      icon: 'tabler:briefcase',
    }, {
      title: '架构师 <br /> <span class="font-normal">浙江-杭州</span> <br /> <span' +
        ' class="text-sm font-normal">2019 - 2023</span>',
      description: `在任职于知名酒店集团期间，我负责参与集团内部系统的建设和优化工作，为集团提供了坚实的技术基础和服务支持。我主导了底层基础服务的开发，确保了系统的稳定性和可扩展性。此外，我还参与了面向消费者的系统设计，提出了多种创新思路，旨在提升用户界面的友好性、增强交互体验，并最终实现了用户满意度的显著提升。我的工作不仅推动了技术进步，也为集团的业务发展和市场竞争力做出了重要贡献。`,
      icon: 'tabler:briefcase',
    },]}
    classes={{container: 'max-w-3xl'}}
  />

  <!-- Steps Widget ****************** -->

  <!-- Features3 Widget ************** -->

  <Features3
    title="技能"
    subtitle=""
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[{
      title: '系统架构',
      description: '擅长根据业务内容完成贴切业务场景的系统架构，并保留一定的扩展性',
    }, {
      title: '软件开发',
      description: '擅长完成软件开发相关的工作',
    }, {
      title: '国产化',
      description: '对信创环境中的软件开发细节了解得当',
    }, {
      title: '图书出版',
      description: '与清华大学出版社合作出版图书三本',
    }, {
      title: '教学指导', description: '能够对软件行业、测绘行业相关内容进行指导教学',
    }, ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="porfolio"
    title="开源项目"
    subtitle="我参与或主导的开源项目"
    isReversed
    items={[{
      title: '描述:',
      description: `这是一个Go语言开发的物联网开发平台，旨在高效完成物联网应用系统开发`,
    }, {
      title: '角色:',
      description: `项目发起人，项目开发人员`,
    },]}
    image={{
      src: '~/assets/images/o1.png',
      alt: 'Fashion e-commerce Image',
    }}
    callToAction={{
      target: '_blank', text: '查看项目', icon: 'tabler:chevron-right', href: 'https://github.com/iot-ecology/go-iot-platform',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Go IoT Platform <br/><span class="text-2xl"></span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
  
  <Content

    isReversed
    isAfterContent={true}
    items={[{
      title: '描述:',
      description: '这是一个数学库，一个用Rust编写的数学库。在这个数学库中尽可能多地以原生方式编写，减少第三方库的使用。',
    }, {
      title: '角色:',
      description: '项目发起人，项目开发人员',
    },]}
    image={{
      src: '~/assets/images/rust-math.png',
      alt: 'Tech Design Image',
    }}
    callToAction={{
      target: '_blank', text: '查看项目', icon: 'tabler:chevron-right', href: 'https://github.com/huifer/rs-math',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Rs Math  <br/><span class="text-2xl"></span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[{
      title: '描述:',
      description: '这是一个使用Java语言开发的有关于地理信息相关的一些算法，包括最大内切圆、最小外切圆等',
    }, {
      title: '角色:',
      description: `项目发起人，项目开发人员`,
    },]}
    image={{
      src: '~/assets/images/java-gis.png',
      alt: 'Art and Music Poster Image',
    }}
    callToAction={{
      target: '_blank', text: '查看项目', icon: 'tabler:chevron-right', href: 'https://github.com/huifer/planar_algorithm',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Planar Algorithm <br/><span class="text-2xl"></span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="客户评价"
    subtitle=""
    testimonials={[{
      testimonial: `感谢你不厌其烦的软件教学，让我在两周的时间内对Java相关开发内容有了更加全面的认识，帮我补充了我的不足。谢谢你`,
      name: '*豪',
      job: '3年工作经验开发者',
    }, {
      testimonial: `由衷的感谢你帮我们设计了整个地理信息系统数据库以及国家测绘标准检查的自动化流程设计。`,
      name: '志*强公司',
      job: 'CEO',
    },]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="和我建立链接"
    subtitle="准备好和我建立链接了吗？"
    actions={[{
      variant: 'primary', text: '联系我', href: 'mailto:huifer97@163.com',
    },]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="我的博客"
    information={``}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
