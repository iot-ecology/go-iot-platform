---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline=""
    title="Go IoT 开发平台定价"
    subtitle="选择一个与您的GoIoT开发平台的计划。"
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="我们的定价"
    subtitle=""
    prices={[
      {
        title: '社区版',
        subtitle: '免费使用，可以提交Issues开发人员会跟进修改',
        price: 0,
        period: '',
        items: [
          {
            description: '核心程序全部开源',
          },
          {
            description: '详细设计文档',
          },
          {
            description: '定制化支持较弱',
          }, {
            description: '社区支持度高',
          },
        ],
        callToAction: {
          target: '_blank',
          text: '下载',
          href: 'https://gitee.com/pychfarm_admin/go-iot-platform',
        },
      },
      {
        title: '标准版',
        subtitle: '在开源基础上提供服务部署指导、二次开发支持',
        price: 299,
        period: '单次',
        items: [
          {
            description: '系统原理讲解',
          },
          {
            description: '提供部署、功能使用中遇到的问题答疑',
          },{
            description: '在客户指定的网络和硬件环境中完成社区版服务部署',
          },{
            description: '提供模拟设备接入到平台中，并能完成正常设备上线、数据上下行',
          },
         
        ],
        callToAction: {
          target: '_blank',
          text: '联系我',
          href: 'mailto:huifer97@163.com',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: '企业版',
        subtitle: '我们接受企业用户的定制为您打造更好的物联网平台',
        price: "面议",
        period: '',
        items: [
          {
            description: '支持企业用户需求定制化开发',
          },
          {
            description: '支持对现有系统进行问题分析排查，提供改进方案',
          },
          {
            description: '将您的想法告诉我们，我们为您定制系统',
          },
          
        ],
        callToAction: {
          target: '_blank',
          text: '联系我',
          href: 'mailto:huifer97@163.com',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="价格相关功能"
    subtitle="了解选择我们计划的优势"
    columns={2}
    items={[
      {
        title: '分层定价计划',
        description: '从一系列定价计划中进行选择，以适应不同的预算和要求。',
        icon: 'tabler:stairs',
      },
      {
        title: '透明定价',
        description: '清晰显示每个计划的定价细节，没有隐藏成本或意外费用。',
        icon: 'tabler:flip-vertical',
      },
      
      {
        title: '升级价值',
        description: '升级到更高级别的计划，以解锁更多功能和好处，从而获得更好的体验。',
        icon: 'tabler:chevrons-up',
      },
      {
        title: '24小时支持',
        description: '每个日历日通过在线聊天、电子邮件或电话回答问题。',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />


  

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="定价常见问题"
    subtitle="选择正确的计划很重要，我们在这里回答您的问题。如果您对我们的定价选项有疑问，那么您来对地方了。"
    columns={1}
    items={[
      {
        title: '这些计划是否附带了客户支持？',
        description:
          '当然，所有计划都包括访问我们专门的客户支持，以协助您解决任何疑问或疑虑。',
      },
      {
        title: '不同的计划有试用期吗？',
        description:
          "很遗憾，我们不提供这些计划的试用期。但是，您可以查看我们的演示部分，预览我们模板的质量。",
      },
      {
        title: '我可以在计划之间切换吗？',
        description:
          '当然！您可以随时轻松升级或降级您的计划，以找到最适合您不断变化的需求的计划。',
      },
      {
        title: '你们接受什么付款方式？',
        description:
          '我们接受主要的信用卡和在线支付方式，以确保交易过程方便安全。',
      },
      {
        title: '除了显示的成本外，还有其他隐藏的费用吗？',
        description:
          '否，订阅费用包括每个计划下列出的所有功能和模板。没有隐藏费用或额外费用。',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="准备好推进项目了吗？"
    subtitle="使用我们的 Go IoT 开发平台快速启动您的物联网平台"
    actions={[
      {
        variant: 'primary',
        text: '联系我们',
        href: 'mailto:huifer97@163.com',
      },
    ]}
  />
</Layout>
