---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Go IoT 开发平台 — 你的物联网开发助手',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '下载',
        href: 'https://gitee.com/pychfarm_admin/go-iot-platform',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: '更多...', href: '#features' },
    ]}
    image={{ src: '~/assets/images/o1.png', alt: 'Go IoT Platform Image' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">Go IoT 开发平台</span> 
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Go IoT 开发平台</span> 是一个使用Go语言开发的免费、高效、可扩展的物联网解决方案。</span
      >
      该平台支持MQTT、HTTP、WebSocket、COAP、TCP/IP协议传输，提供轻量化的配置工具完成数据的报警功能，提供基于JavaScript的数据统计服务。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!--<Note />-->

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline=""
    title="Go IoT开发平台能为你带来..."
    subtitle="市场上顶级的物联网开发平台因其速度、易用性和广泛的兼容性而广受青睐，为开发人员提供了高效、直观和强大的开发环境。"
    items={[
      {
        title: '多协议支持',
        description:
          '平台支持基于MQTT、HTTP、WebSocket、COAP、TCP/IP协议传输的设备对接',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: '海量MQTT客户端管理',
        description:
          '我们自主开发的监控系统确保MQTT客户端能够持续稳定地保持在线。该系统具有负载平衡能力，可以在发生故障时自动切换。',
        icon: 'tabler:subtask',
      },
      {
        title: '报警分析',
        description:
          '用户不需要编写繁琐的程序代码，他们可以通过简单直观的Web界面为数据报警设置相关选项。',
        icon: 'tabler:bell-ringing',
      },
      {
        title: '数据可视化',
        description:
          '我们使用直观的图表（包括折线图和条形图等），使用户能够快速准确地理解数据的关键信息。',
        icon: 'tabler:chart-bar',
      },
      {
        title: '离线计算',
        description:
          "我们提供强大的离线分析工具，使用户能够更深入地研究历史数据，进行详细的处理和分析。",
        icon: 'tabler:calculator',
      },
      {
        title: '脚本',
        description:
          '用户可以使用自定义脚本来个性化和处理设备上报消息，包括警报分析和计算分析，从而提高数据处理的灵活性和自动化水平。',
        icon: 'tabler:script',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline=""
    title="Go IoT 开发平台蓝图"
    items={[
      {
        title: '持续发展',
        description:
          '完成核心业务，如大规模MQTT客户端管理、数据分析、生产计划和多协议对接方案。',
      },
      {
        title: '基于Go语言开发',
        description:
          'Golang因其简单、高效、并发支持和强大的标准库而受到开发人员的喜爱。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">建立在现代基础之上</h3>
      通过整合行业领先的实践获得竞争优势
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '极速接入',
        description: `使用MQTT协议轻松连接设备进行传输，整个过程只需1分钟。`,
      },
      {
        title: '开源',
        description:
          '此项目支持源代码交付。您可以根据自己的需要进行修改，也可以联系我们进行相关开发，并通过Gitee提交问题。',
      },
      {
        title: '微服务架构',
        description:
          "该项目采用微服务架构，分为MQTT管理端、消息队列消费端、后端管理端和其他核心组件。",
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '增强用户参与度',
        description:
          '我们希望用户能够与我们合作，为Go-IoT开发平台建立一个社区，就功能模块交流意见，使项目更加用户友好。',
      },
      {
        title: '持续改进',
        description:
          '如果您在使用过程中遇到任何问题，可以通过提交问题与我们联系，我们将继续解决此问题，直到问题得到解决。',
      },
      {
        title: '时间和资源效率',
        description:
          '我们希望用户在使用该项目时，能够大大减少不必要的开发投资，快速高效地构建自己的物联网基础设施平台。',
      },
      {
        title: '社区支持',
        description: `加入不断壮大的Go IoT 开发平台社区，获取见解、资源和帮助，确保您在IoT开发之旅中永远不会孤单。`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">旨在促进成长和成功。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="使用Go IoT 开发平台，让您的梦想物联网平台快速启动并运行。"
    items={[
      {
        title: 'Step 1: <span class="font-medium">下载</span>',
        description:
          "使用Gitee下载我们的项目，通常建议您使用开发分支，这将为我们的开发版本带来更多新功能。",
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">编译</span>',
        description:
          "当您希望在本地下载项目时，需要执行依赖项安装并编译项目",
        icon: 'tabler:letter-case',
      },
      {
        title: 'Step 3: <span class="font-medium">配置</span>',
        description:
          '编译后，您需要对启动环境进行基本配置，包括MySQL、Mongo等',
        icon: 'tabler:paint',
      },
      {
        title: '准备完成!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="核心功能"
    subtitle="使用以下功能快速建立物联网数据平台。"
    tagline=""
    items={[
      {
        title: '存储方案',
        description: "使用Influxdb、MongoDB、Redis和MySQL作为数据存储解决方案",
        icon: 'flat-color-icons:database',
      },
      {
        title: '安装记录',
        description:
          "能够记录设备安装日志",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '数据计算器',
        description:
          '支持离线数据计算',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '报警分析',
        description:
          "支持间隔报警和脚本报警，以最大限度地提高报警场景的满意度",
        icon: 'flat-color-icons:document',
      },
      {
        title: '高可用',
        description:
          '核心MQTT客户端管理支持多节点部署，实现高可用性',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '定价',
        description: '基本版免费，支持定制服务',
        icon: 'flat-color-icons:currency-exchange',
      },
     
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="关注博客了解跟多"
    information={`在博客中介绍了关于Go IoT开发平台的一切，Go-IoT开发平台是一项非常有趣的技术。
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="IoT平台常见问题"
    subtitle="深入探讨以下问题，以深入了解Go IoT 开发平台提供的强大功能，以及它如何提升您的物联网开发旅程。"
    tagline=""
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '为什么选择GoIot开发平台',
        description:
          "Go-IoT平台集成了物联网项目所需的基础设施，使您能够快速投资于业务开发，而无需处理繁琐的交易。",
      },
      {
        title: '如何开始',
        description:
          '尝试模拟MQTT客户端以完成数据传输，然后通过此平台查看数据。',
      }
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '下载量', amount: '10+' },
      { title: '星', amount: '20+' },
      { title: '分叉', amount: '3' },
      { title: '用户', amount: '10' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '下载',
        href: 'https://gitee.com/pychfarm_admin/go-iot-platform',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Go IoT 开发平台
    </Fragment>

    <Fragment slot="subtitle">
      看到这里还在等什么？ <br class="hidden md:inline" />快来加入 Go IoT 开发平台的使用吧^_^
    </Fragment>
  </CallToAction>
</Layout>
